# --- PayPal (SANDBOX ONLY) -------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > Create App
# Leave empty to run in MOCK mode (simulated PayPal, no network calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
CURRENCY=EUR

# --- AI (any OpenAI-compatible chat endpoint with tool calling) -----------
# Google Gemini (free tier):  https://generativelanguage.googleapis.com/v1beta/openai/   model gemini-2.5-flash
# Groq (free tier):           https://api.groq.com/openai/v1/                            model llama-3.3-70b-versatile
# Local Ollama:               http://localhost:11434/v1/                                 model qwen2.5:7b
# Leave AI_API_KEY empty to use the built-in deterministic rules agent.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# --- App ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# Optional: protect the merchant console with a password (basic auth, user "merchant")
CONSOLE_PASSWORD=
DB_PATH=settle.db
